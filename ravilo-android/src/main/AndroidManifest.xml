<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- R216 — normal (install-time) permissions read at startPlayback to report the network link
         (ConnectivityManager/WifiInfo.linkSpeed); neither is runtime-gated, so this adds no permission
         prompt (see HdrCapabilities.kt's detectLinkState() doc). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- R224 — universal app: neither feature is required, so Play distributes this one listing to
         both Android TV (leanback launcher, below) and phones/tablets (standard launcher, below).
         Was leanback required="true" (TV-only distribution) until the TV and phone apps merged. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Bug fix (found live 2026-09-03, Play Console filtered out every TV as "not compatible"):
         `.phone.MainActivity`'s android:screenOrientation="portrait" makes the manifest merger imply
         android.hardware.screen.portrait as REQUIRED — Android TV has no portrait mode at all, so Play's
         device filter excludes every TV from this one listing on that basis alone. Explicit override
         wins over the implied one. -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/banner"
        android:label="Ravilo"
        android:theme="@style/Theme.Ravilo.Splash"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">
        <!-- R245 — the Cast SDK's options provider (ravilo-ui androidMain). The receiver application id
             is a placeholder here and is applied at RUNTIME from the config snapshot (218 FR-218-11). -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="dev.jellystructure.ravilo.ui.seams.RaviloCastOptionsProvider" />
        <!-- R245 (FR-R245-2) — Output Switcher discovery of Cast devices. -->
        <receiver
            android:name="androidx.mediarouter.media.MediaTransferReceiver"
            android:exported="true" />

        <!-- TV entry point — leanback/D-pad UI, full-screen immersive. Only the TV launcher sees this
             (LEANBACK_LAUNCHER); the phone launcher uses the separate activity below instead. -->
        <activity
            android:name=".android.MainActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|uiMode|orientation|screenLayout|smallestScreenSize|colorMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phone/tablet entry point — touch UI, portrait, standard system-bar windowing. R60/R224. -->
        <activity
            android:name=".phone.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|orientation|uiMode|colorMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
