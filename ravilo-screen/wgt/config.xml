<?xml version="1.0" encoding="UTF-8"?>
<!--
    R264 — Tizen widget manifest, superseding ravilo-tizen's (R189). `package` MUST stay exactly 10
    characters — Samsung's installer fails with "Load archive info fail" on any other length, an
    undocumented constraint found empirically against a real Tizen 10.0 TV emulator (ravilo-tizen's own
    "RaviloTizen" is 11 chars and has always carried this same latent bug). The TV emulator (Samsung TV
    Extension 7.0.1+) also only installs a .wgt signed with a genuine Samsung-issued certificate profile,
    not a generic Tizen distributor certificate — see the Certificate Manager section of the phase's dev
    notes for how the "Ravilo" profile was created.
-->
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://jellystructure.dev/ravilo-screen"
        version="1.0.0"
        viewmodes="fullscreen">
    <tizen:application id="RaviloScrn.RaviloScrn" package="RaviloScrn" required_version="2.4"/>
    <name>Ravilo</name>
    <icon src="icon.png"/>
    <content src="index.html"/>
    <tizen:profile name="tv"/>
    <feature name="http://tizen.org/feature/screen.size.normal.d"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/avplay"/>
    <tizen:setting screen-orientation="landscape"
                    context-menu="disable"
                    background-support="disable"
                    encryption="disable"
                    install-location="auto"
                    hwkey-event="enable"/>
</widget>
