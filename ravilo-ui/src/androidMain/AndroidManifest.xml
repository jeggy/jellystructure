<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- DEB-4910 (FR-6) — the stock home is found at run time as whatever Android resolves the Home intent to. Android 11+ hides
         other apps from a query unless it is declared; this is the query, not a HOME entry of Ravilo's own (FR-7). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application>
        <!-- DEB-4910 (FR-7) — the home-screen hook. DISABLED by default: Ravilo enables this component itself only when the
             viewer turns on "Use Ravilo as home screen" on a TV, so a phone never lists it in Android's accessibility settings. -->
        <service
            android:name="dev.jellystructure.ravilo.ui.homehook.RaviloHomeHookService"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ravilo_home_hook_service" />
        </service>
    </application>

</manifest>
