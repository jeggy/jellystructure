<?xml version="1.0" encoding="UTF-8"?>
<!--
    R189 — Tizen widget manifest. Scaffolded per Samsung's documented Tizen Studio TV project layout;
    NOT verified against a real `tizen package`/sideload — this environment has no Tizen Studio install
    (see the phase spec's Verification section). The `<tizen:profile name="tv"/>` + `required_version`
    pair is what actually gates which TV generations can install this; 2.4 covers the 2016 floor.
-->
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://jellystructure.dev/ravilo-tizen"
        version="1.0.0"
        viewmodes="fullscreen">
    <tizen:application id="RaviloTizen.RaviloTizen" package="RaviloTizen" required_version="2.4"/>
    <name>Ravilo</name>
    <icon src="icon.png"/>
    <content src="index.html"/>
    <tizen:profile name="tv"/>
    <feature name="http://tizen.org/feature/screen.size.normal.d"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/avplay"/>
    <tizen:setting screen-orientation="landscape"
                    context-menu="disable"
                    background-support="disable"
                    encryption="disable"
                    install-location="auto"
                    hwkey-event="enable"/>
</widget>
