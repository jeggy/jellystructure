-- Phase 254 (FR-254-3) — one row per video file that has had a deep check (a whole-file demux pass).
-- A row is CURRENT only while the file's size and mtime still equal the ones stored here: anything
-- that rewrites the file makes it unchecked again with no bookkeeping. damage_count = 0 is "checked,
-- and clean"; no row (or a stale one) is "unchecked" — never the same thing (FR-254-4).
CREATE TABLE file_integrity (
    path TEXT NOT NULL PRIMARY KEY,
    size INTEGER NOT NULL,
    mtime INTEGER NOT NULL,
    checked_at INTEGER NOT NULL,
    damage_count INTEGER NOT NULL,
    first_damage TEXT
);

CREATE INDEX file_integrity_damaged ON file_integrity(damage_count);

put:
INSERT OR REPLACE INTO file_integrity(path, size, mtime, checked_at, damage_count, first_damage)
VALUES (:path, :size, :mtime, :checked_at, :damage_count, :first_damage);

all:
SELECT * FROM file_integrity;

damaged:
SELECT * FROM file_integrity WHERE damage_count > 0;

remove:
DELETE FROM file_integrity WHERE path = :path;

-- Phase 261 (dev review item 1) — the Jobs view's "N findings today": read from the results, not the job rows
-- (a check succeeds whether or not the file is damaged).
countFindingsSince:
SELECT COUNT(*) FROM file_integrity WHERE checked_at >= :since AND damage_count > 0;

-- Phase 261 (FR-261-10) — one file's stored result, for the title page's Checks card.
byPath:
SELECT * FROM file_integrity WHERE path = :path;
