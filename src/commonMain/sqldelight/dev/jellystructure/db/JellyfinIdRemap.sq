-- Phase 316 (FR-316-4 step 6, dev review 7) — a film moved into its own folder gets a new Jellyfin item id (Jellyfin
-- derives ids from the path). Every table that keys a video by its Jellyfin id follows it to the new one; tables keyed
-- by the media slug need nothing. `OR IGNORE` keeps a row that would collide with one the new id already has.

remapPlaybackSession:
UPDATE OR IGNORE playback_session SET item_id = :new_id, queue_json = replace(queue_json, :old_id, :new_id) WHERE item_id = :old_id;

remapStartSample:
UPDATE OR IGNORE playback_start_sample SET item_id = :new_id WHERE item_id = :old_id;

remapQoe:
UPDATE OR IGNORE playback_qoe SET jellyfin_id = :new_id WHERE jellyfin_id = :old_id;

remapOutbox:
UPDATE OR IGNORE playback_outbox SET jellyfin_id = :new_id WHERE jellyfin_id = :old_id;

remapDirtyItem:
UPDATE OR IGNORE dirty_item SET jellyfin_id = :new_id WHERE jellyfin_id = :old_id;

remapRecommendation:
UPDATE OR IGNORE recommendation SET item_id = :new_id WHERE item_id = :old_id;

remapRecommendationReason:
UPDATE OR IGNORE recommendation SET reason_item_id = :new_id WHERE reason_item_id = :old_id;

remapStarterList:
UPDATE OR IGNORE starter_list SET item_id = :new_id WHERE item_id = :old_id;

remapAiOrder:
UPDATE OR IGNORE ai_order SET item_id = :new_id WHERE item_id = :old_id;

remapAiTheme:
UPDATE OR IGNORE ai_theme SET item_id = :new_id WHERE item_id = :old_id;

changes:
SELECT changes();

-- FR-316-9 (DEB-1252) — the key of every row that sits on an id, read before and after each remap above so the move
-- can write down exactly which rows it carried (`before_snapshot`). `OR IGNORE` skips a collision, so a row that is
-- still on the old id after its update was not moved. Key columns are each table's own primary key.
sessionKeysOn:
SELECT id, queue_json FROM playback_session WHERE item_id = :old_id;

sampleKeysOn:
SELECT id FROM playback_start_sample WHERE item_id = :old_id;

qoeKeysOn:
SELECT device_id, play_session_id FROM playback_qoe WHERE jellyfin_id = :old_id;

outboxKeysOn:
SELECT device_id FROM playback_outbox WHERE jellyfin_id = :old_id;

dirtyKeysOn:
SELECT id FROM dirty_item WHERE jellyfin_id = :old_id;

recommendationKeysOn:
SELECT user_id, scope_key, rank FROM recommendation WHERE item_id = :old_id;

recommendationReasonKeysOn:
SELECT user_id, scope_key, rank FROM recommendation WHERE reason_item_id = :old_id;

starterKeysOn:
SELECT scope_key, rank FROM starter_list WHERE item_id = :old_id;

aiOrderKeysOn:
SELECT user_id, scope_key, rank FROM ai_order WHERE item_id = :old_id;

aiThemeKeysOn:
SELECT item_id FROM ai_theme WHERE item_id = :old_id;
