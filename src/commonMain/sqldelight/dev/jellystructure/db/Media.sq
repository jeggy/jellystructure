CREATE TABLE media (
    id TEXT NOT NULL PRIMARY KEY,
    json TEXT NOT NULL,
    kind TEXT NOT NULL,
    title TEXT NOT NULL,
    year INTEGER,
    studio TEXT,
    network TEXT,
    issue_count INTEGER NOT NULL DEFAULT 0,
    language_mix INTEGER NOT NULL DEFAULT 0,
    scanned_at INTEGER NOT NULL,
    tmdb_id INTEGER,
    poster_path TEXT,
    episode_count INTEGER NOT NULL DEFAULT 0,
    search_text TEXT NOT NULL DEFAULT '',
    -- Phase 196 — epoch ms of the last COMPLETED examination of this title's files on disk (a scan /
    -- targeted sync that actually probed them). Set ONLY by those paths; never by a metadata write.
    -- It is the freshness filter's threshold, so anything else touching it defers a real scan — which
    -- is exactly the bug this rename closes (it was `last_checked`, stamped on every row write).
    last_examined_at INTEGER,
    has_segments INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX media_kind ON media(kind);
CREATE INDEX media_scanned_at ON media(scanned_at);
CREATE INDEX media_search_text ON media(search_text);
CREATE INDEX media_has_segments ON media(has_segments);

upsert:
INSERT OR REPLACE INTO media(id, json, kind, title, year, studio, network, issue_count, language_mix, scanned_at, tmdb_id, poster_path, episode_count, search_text, last_examined_at, has_segments)
VALUES (:id, :json, :kind, :title, :year, :studio, :network, :issue_count, :language_mix, :scanned_at, :tmdb_id, :poster_path, :episode_count, :search_text, :last_examined_at, :has_segments);

getById:
SELECT json FROM media WHERE id = :id;

getAll:
SELECT json FROM media;

count:
SELECT COUNT(*) FROM media;

countByKind:
SELECT COUNT(*) FROM media WHERE kind = :kind;

sumIssueCount:
SELECT COALESCE(SUM(issue_count), 0) FROM media;

sumEpisodeCount:
SELECT COALESCE(SUM(episode_count), 0) FROM media WHERE kind = 'TV_SHOW';

countLanguageMix:
SELECT COUNT(*) FROM media WHERE language_mix = 1;

listFiltered:
SELECT json FROM media
WHERE (:kind IS NULL OR kind = :kind)
  AND (:filterAttention = 0 OR (issue_count > 0 OR language_mix = 1))
  AND (:filterMissingArtwork = 0 OR poster_path IS NULL)
  AND (:search IS NULL OR lower(title) LIKE ('%' || lower(:search) || '%'));

allIds:
SELECT id FROM media;

searchIds:
SELECT id FROM media WHERE search_text LIKE ('%' || :search || '%');

countEmptySearchText:
SELECT COUNT(*) FROM media WHERE search_text = '';

allLastExamined:
SELECT id, last_examined_at FROM media WHERE last_examined_at IS NOT NULL;

touchLastExamined:
UPDATE media SET last_examined_at = :last_examined_at WHERE id = :id;

-- Phase 196 (FR-196-1) — `upsert` is INSERT OR REPLACE, so it rewrites every column on every write.
-- A caller that did not examine this title's files reads the stored value with this and hands it
-- straight back, exactly as Phase 163 already does for has_segments in the same function.
getLastExamined:
SELECT last_examined_at FROM media WHERE id = :id;

updateSearchText:
UPDATE media SET search_text = :search_text WHERE id = :id;

-- Phase 163 — a cheap point-update for has_segments, called by MediaSegmentStore after every write/
-- delete to media_segment, instead of decoding+re-encoding the whole JSON blob just to flip one flag.
updateHasSegments:
UPDATE media SET has_segments = :has_segments WHERE id = :id;

-- Phase 163 — read the current has_segments value so upsertItemDbOnly can carry it forward on an
-- unrelated item write instead of recomputing it from the now-stale SegmentMarkers blob (which would
-- silently stomp MediaSegmentStore's own point-update the next time anything else touches this item).
getHasSegments:
SELECT has_segments FROM media WHERE id = :id;

deleteById:
DELETE FROM media WHERE id = :id;

deleteAll:
DELETE FROM media;
