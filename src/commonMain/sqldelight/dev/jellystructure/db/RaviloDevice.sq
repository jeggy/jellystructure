-- One row per (device, user) pair; one device may have multiple signed-in users (R18).
CREATE TABLE ravilo_device (
    device_id TEXT NOT NULL,
    jellyfin_user_id TEXT NOT NULL,
    jellyfin_username TEXT NOT NULL,
    jellyfin_user_token TEXT NOT NULL,
    is_admin INTEGER NOT NULL DEFAULT 0,
    is_kids INTEGER NOT NULL DEFAULT 0,
    device_token TEXT NOT NULL UNIQUE,
    display_name TEXT NOT NULL DEFAULT '',
    created_at INTEGER NOT NULL,
    last_seen INTEGER NOT NULL,
    -- Phase 142: normalized (no dashes, lowercased), comma-joined Jellyfin library ids this user may
    -- see; NULL = unrestricted (admin or EnableAllFolders). Refreshed on every login.
    allowed_libraries TEXT,
    -- Phase 142 follow-up: lowercased, comma-joined Jellyfin Policy AllowedTags/BlockedTags. Refreshed
    -- on every login, same as allowed_libraries.
    allowed_tags TEXT,
    blocked_tags TEXT,
    -- Phase 185 (FR-185-1) — this device's own real hardware decode ceiling (bps), read straight off
    -- R216's ClientCapabilities on every playback negotiation (PlaybackService.startPlayback), never
    -- inferred or invented. Kept per codec, not one shared value — live playback_qoe evidence showed a
    -- single-slot design would be wrong: this same TV always reports its AVC decoder (R183/R216 force an
    -- AVC transcode target) even for 4K sessions, so a single column would silently record the AVC
    -- ceiling while FR-185-6's predicate needs the HEVC direct-play one for an HEVC file. NULL = "not
    -- measured yet" (FR-185-2) — no Ravilo session since this device's build started reporting it, or a
    -- client (Ravilo Web) that can't report a ceiling at all. A NULL ceiling means no slow-start note,
    -- ever, for that codec — never treated as unlimited or as constrained.
    decode_max_bitrate_hevc INTEGER,
    decode_max_bitrate_h264 INTEGER,
    -- Epoch MILLISECONDS (matches last_seen/created_at above — NOT playback_qoe.updated_at, which is
    -- seconds; verified against the live DB 2026-09-02, see the phase spec's own note). One shared
    -- timestamp for both columns above: ClientCapabilities reports both ceilings together on every
    -- negotiation, so they're always written in the same statement.
    decode_measured_at INTEGER,
    -- Phase 224 (FR-224-2) — which build and which kind of client last spoke for this row, from the
    -- X-Ravilo-Version / X-Ravilo-Platform headers every R252 client sends on every request. Written on
    -- login and whenever the pair changes — never per request. NULL = the device has never said (an
    -- un-updated client); never a placeholder, and the Jellyfin header then carries no Version at all.
    app_version TEXT,
    platform TEXT,
    -- Phase 236 (FR-236-1) — tv | phone | web | cast | screen. Migrated from the DEVICE_PREFIX name
    -- check and R252's platform column (see 47.sqm's backfill); a Chromecast receiver and a Tizen/webOS
    -- receiver both behave as 'screen' everywhere except the two sites that still care which one (218's
    -- session ceiling, the Jellyfin dashboard identity string).
    kind TEXT NOT NULL DEFAULT 'tv',
    -- Phase 236 (FR-236-6) — stamped on an events-socket open and a playback/status post.
    last_public_address TEXT,
    PRIMARY KEY (device_id, jellyfin_user_id)
);

insertDevice:
INSERT OR REPLACE INTO ravilo_device(device_id, jellyfin_user_id, jellyfin_username, jellyfin_user_token, is_admin, is_kids, device_token, display_name, created_at, last_seen, allowed_libraries, allowed_tags, blocked_tags, app_version, platform, kind)
VALUES (:device_id, :jellyfin_user_id, :jellyfin_username, :jellyfin_user_token, :is_admin, :is_kids, :device_token, :display_name, :created_at, :last_seen, :allowed_libraries, :allowed_tags, :blocked_tags, :app_version, :platform, :kind);

-- Phase 224 (FR-224-2) — one write per change: RaviloDeviceService compares the request's headers with
-- the cached row and calls this only when the pair differs.
updateAppInfo:
UPDATE ravilo_device SET app_version = :app_version, platform = :platform WHERE device_token = :device_token;

getByToken:
SELECT * FROM ravilo_device WHERE device_token = :device_token;

getByDevice:
SELECT * FROM ravilo_device WHERE device_id = :device_id ORDER BY last_seen DESC;

getByDeviceAndUser:
SELECT * FROM ravilo_device WHERE device_id = :device_id AND jellyfin_user_id = :jellyfin_user_id;

-- Phase 111 — every device paired to this Jellyfin user (remote-control device list, Ravilo config editor).
getByUser:
SELECT * FROM ravilo_device WHERE jellyfin_user_id = :jellyfin_user_id ORDER BY last_seen DESC;

-- Phase 143 — every device row across every user, for the Users & Devices admin overview.
getAllDevices:
SELECT * FROM ravilo_device ORDER BY jellyfin_user_id, last_seen DESC;

updateLastSeen:
UPDATE ravilo_device SET last_seen = :last_seen WHERE device_token = :device_token;

-- Phase 236 (FR-236-6) — stamped on an events-socket open and a playback/status post, not every
-- request (see RaviloDeviceService.recordAddress's doc for why).
updatePublicAddress:
UPDATE ravilo_device SET last_public_address = :last_public_address WHERE device_id = :device_id AND jellyfin_user_id = :jellyfin_user_id;

deleteByToken:
DELETE FROM ravilo_device WHERE device_token = :device_token;

deleteByDeviceAndUser:
DELETE FROM ravilo_device WHERE device_id = :device_id AND jellyfin_user_id = :jellyfin_user_id;

-- Phase 143 — "sign out everywhere": every device row this Jellyfin user has ever signed into.
deleteByUser:
DELETE FROM ravilo_device WHERE jellyfin_user_id = :jellyfin_user_id;

-- Phase 185 (FR-185-1) — the newest measurement is always the truth (a firmware update can change it),
-- so a reported value always overwrites. COALESCE on each column independently: a negotiation that
-- reports only one codec's ceiling (the other came back 0/unknown that round) must not null out a
-- previously-known-good value for the OTHER codec — only a genuinely reported number ever changes a
-- column. PlaybackService only calls this at all when at least one of the two is non-null.
updateDecodeCapabilities:
UPDATE ravilo_device
SET decode_max_bitrate_hevc = COALESCE(:decode_max_bitrate_hevc, decode_max_bitrate_hevc),
    decode_max_bitrate_h264 = COALESCE(:decode_max_bitrate_h264, decode_max_bitrate_h264),
    decode_measured_at = :decode_measured_at
WHERE device_id = :device_id AND jellyfin_user_id = :jellyfin_user_id;

-- Phase 185 (FR-185-5/FR-185-8) — this device's persisted decode ceiling, read by both the detail
-- payload's playbackNote resolution and the admin Users & devices row.
getDecodeCapabilities:
SELECT decode_max_bitrate_hevc, decode_max_bitrate_h264, decode_measured_at
FROM ravilo_device WHERE device_id = :device_id AND jellyfin_user_id = :jellyfin_user_id;
