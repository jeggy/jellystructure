CREATE TABLE ravilo_config (
    user_id TEXT NOT NULL PRIMARY KEY,
    json TEXT NOT NULL,
    updated_at INTEGER NOT NULL
);

upsert:
INSERT OR REPLACE INTO ravilo_config(user_id, json, updated_at)
VALUES (:user_id, :json, :updated_at);

getByUser:
SELECT json FROM ravilo_config WHERE user_id = :user_id;

deleteByUser:
DELETE FROM ravilo_config WHERE user_id = :user_id;

-- R162: one-time boot migration walks every per-user record to lift legacy behaviour fields
-- (viewerSkinOverride/tileShape/showContinueProgress/autoplayNext/uiLanguage) into the new overlay.
allUserIds:
SELECT user_id FROM ravilo_config;
