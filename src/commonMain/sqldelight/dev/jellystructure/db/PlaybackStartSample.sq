-- Phase 185 (FR-185-4) — append-only start-time samples, written ONLY on session completion (a client-
-- reported startupMs on /tv/playback/stop — never mid-session, never for a session abandoned before
-- first frame, since the client can't compute a duration to a frame that never rendered). device_id is
-- epoch MILLISECONDS throughout (recorded_at), matching ravilo_device, not playback_qoe's seconds.
-- file_id is the on-disk path (Phase 149's own multi-episode grouping key, R179) — never the Jellyfin
-- item id, so a combined S01E01-E03 file's three episodes share one history, per FR-185-9.
CREATE TABLE playback_start_sample (
    id INTEGER NOT NULL PRIMARY KEY,
    device_id TEXT NOT NULL,
    item_id TEXT NOT NULL,
    file_id TEXT NOT NULL,
    seconds INTEGER NOT NULL,
    recorded_at INTEGER NOT NULL
);

CREATE INDEX playback_start_sample_device_file ON playback_start_sample(device_id, file_id);

insert:
INSERT INTO playback_start_sample(device_id, item_id, file_id, seconds, recorded_at)
VALUES (:device_id, :item_id, :file_id, :seconds, :recorded_at);

-- FR-185-7 — most-recent-first; the caller takes the median of however many come back (0..N).
recentForDeviceAndFile:
SELECT seconds FROM playback_start_sample
WHERE device_id = :device_id AND file_id = :file_id
ORDER BY recorded_at DESC LIMIT :limit;

-- FR-185-4 — retention: keep only the most recent [max_rows] per (device, file); a firmware update or
-- network change makes older samples misleading. Same DELETE-NOT-IN-subquery shape as
-- media_history.trimToMax.
pruneToMax:
DELETE FROM playback_start_sample
WHERE device_id = :device_id AND file_id = :file_id AND id NOT IN (
    SELECT id FROM playback_start_sample
    WHERE device_id = :device_id AND file_id = :file_id
    ORDER BY recorded_at DESC LIMIT :max_rows
);
