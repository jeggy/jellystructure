-- DEB-2476 (DEB-2474, FR-2/FR-4/FR-6/FR-15/FR-16) — Auto-fetch: fetchers (with their recipes), the per-site lane state, each fetcher's items (the
-- placed path and item id retention counts, FR-16.2; the page's own title/overview/air date, FR-8.2/FR-15.4), run records, and the page-only
-- mark the scan reads (FR-15.5). Must stay byte-for-byte in sync with Autofetch.sq's CREATE TABLE statements.
CREATE TABLE autofetch_fetcher (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    page_url TEXT NOT NULL,
    site TEXT NOT NULL,
    tmdb_id INTEGER,
    page_only INTEGER NOT NULL DEFAULT 0,
    library_path TEXT NOT NULL,
    series_path TEXT NOT NULL,
    recipe_json TEXT NOT NULL,
    proven INTEGER NOT NULL DEFAULT 0,
    retention TEXT NOT NULL,
    schedule TEXT NOT NULL,
    enabled INTEGER NOT NULL DEFAULT 1,
    state TEXT NOT NULL DEFAULT 'ok',
    state_reason TEXT NOT NULL DEFAULT '',
    created_at INTEGER NOT NULL,
    last_run_at INTEGER,
    last_list_ok_at INTEGER
);
CREATE INDEX autofetch_fetcher_by_site ON autofetch_fetcher(site);

CREATE TABLE autofetch_site (
    site TEXT NOT NULL PRIMARY KEY,
    stopped_reason TEXT,
    stopped_at INTEGER,
    robots_text TEXT,
    robots_fetched_at INTEGER,
    backoff_until INTEGER,
    backoff_level INTEGER NOT NULL DEFAULT 0,
    rate_limited_day TEXT,
    rate_limited_count INTEGER NOT NULL DEFAULT 0,
    ever_ok INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE autofetch_item (
    fetcher_id TEXT NOT NULL,
    item_id TEXT NOT NULL,
    link TEXT NOT NULL,
    title TEXT,
    description TEXT,
    published TEXT,
    list_order INTEGER NOT NULL DEFAULT 0,
    season INTEGER,
    episode INTEGER,
    duration INTEGER,
    media_value TEXT,
    state TEXT NOT NULL DEFAULT 'new',
    failures INTEGER NOT NULL DEFAULT 0,
    note TEXT NOT NULL DEFAULT '',
    placed_path TEXT,
    placed_at INTEGER,
    missing_since INTEGER,
    last_seen_at INTEGER,
    PRIMARY KEY (fetcher_id, item_id)
);
CREATE INDEX autofetch_item_by_path ON autofetch_item(placed_path);

CREATE TABLE autofetch_run (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    fetcher_id TEXT NOT NULL,
    started_at INTEGER NOT NULL,
    finished_at INTEGER,
    run_trigger TEXT NOT NULL,
    status TEXT NOT NULL,
    summary TEXT NOT NULL DEFAULT '',
    lines_json TEXT NOT NULL DEFAULT '[]'
);
CREATE INDEX autofetch_run_by_fetcher ON autofetch_run(fetcher_id, started_at);

CREATE TABLE autofetch_series_mark (
    series_path TEXT NOT NULL PRIMARY KEY,
    fetcher_id TEXT NOT NULL
);
