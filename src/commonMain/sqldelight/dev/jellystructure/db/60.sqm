-- Phase 280 — audiobooks (books, parts, authors, per-listener progress and bookmarks). Must stay in sync with Audiobooks.sq.

CREATE TABLE audiobook (
    id TEXT NOT NULL PRIMARY KEY,
    library_id TEXT,
    json TEXT NOT NULL,
    title TEXT NOT NULL,
    missing_since INTEGER,
    updated_at INTEGER NOT NULL
);

CREATE TABLE audiobook_part (
    id TEXT NOT NULL PRIMARY KEY,
    book_id TEXT NOT NULL,
    json TEXT NOT NULL,
    missing_since INTEGER,
    updated_at INTEGER NOT NULL
);

CREATE TABLE audiobook_author (
    id TEXT NOT NULL PRIMARY KEY,
    json TEXT NOT NULL,
    name TEXT NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE audiobook_progress (
    user_id TEXT NOT NULL,
    book_id TEXT NOT NULL,
    part_index INTEGER NOT NULL DEFAULT 0,
    position_ms INTEGER NOT NULL DEFAULT 0,
    speed REAL NOT NULL DEFAULT 1.0,
    updated_at INTEGER NOT NULL,
    finished_at INTEGER,
    PRIMARY KEY (user_id, book_id)
);

CREATE TABLE audiobook_bookmark (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id TEXT NOT NULL,
    book_id TEXT NOT NULL,
    position_ms INTEGER NOT NULL,
    note TEXT,
    created_at INTEGER NOT NULL
);

CREATE INDEX audiobook_part_book ON audiobook_part(book_id);
CREATE INDEX audiobook_progress_book ON audiobook_progress(book_id);
CREATE INDEX audiobook_bookmark_user_book ON audiobook_bookmark(user_id, book_id);
