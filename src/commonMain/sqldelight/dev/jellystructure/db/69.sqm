-- Phase 307 — nothing goes to a public database until someone presses Publish. Must stay in sync with Publish.sq.
-- Drops nothing.

CREATE TABLE publish_item (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    target TEXT NOT NULL,
    kind TEXT NOT NULL,
    subject TEXT NOT NULL,
    label TEXT NOT NULL,
    payload TEXT NOT NULL,
    reason TEXT NOT NULL DEFAULT '',
    state TEXT NOT NULL DEFAULT 'waiting',
    queued_at INTEGER NOT NULL,
    queued_by TEXT NOT NULL,
    decided_at INTEGER,
    decided_by TEXT,
    sent_at INTEGER,
    answer TEXT,
    attempts INTEGER NOT NULL DEFAULT 0
);

-- FR-307-1 — the same subject is never queued twice while not dismissed (a dismissed row is the declined record).
CREATE UNIQUE INDEX publish_item_live ON publish_item(target, kind, subject) WHERE state != 'dismissed';
CREATE INDEX publish_item_state ON publish_item(state, queued_at);
