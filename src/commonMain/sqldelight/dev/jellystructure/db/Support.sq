-- 320 (FR-320-2) — the support lane's store: a ticket per filing and the messages on it. The ticket's id IS the
-- number a viewer sees (`#41`). Times are epoch SECONDS (like media_job and file_av_sync). Every name carries
-- `support_`/`Support` because "ticket" already means a stream ticket here. Must stay byte-for-byte in sync with
-- 79.sqm (the SQLDelight-migration rule). `device_id` is FR-320-7's "per device" and never leaves the server.
CREATE TABLE support_ticket (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    owner_user_id TEXT NOT NULL,
    state TEXT NOT NULL,
    holder TEXT NOT NULL,
    holder_seat TEXT,
    owes TEXT NOT NULL,
    owed_since INTEGER NOT NULL,
    class TEXT,
    english_summary TEXT,
    viewer_language TEXT NOT NULL,
    flagged INTEGER NOT NULL DEFAULT 0,
    admin_read_message_id INTEGER NOT NULL DEFAULT 0,
    viewer_read_message_id INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    title TEXT,
    english_title TEXT
);

CREATE INDEX support_ticket_owner ON support_ticket(owner_user_id, created_at);

CREATE TABLE support_message (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    ticket_id INTEGER NOT NULL,
    kind TEXT NOT NULL,
    author TEXT,
    author_label TEXT,
    body TEXT,
    event TEXT,
    event_args TEXT,
    visibility TEXT NOT NULL,
    device_platform TEXT,
    device_id TEXT,
    created_at INTEGER NOT NULL,
    actor TEXT,
    actor_label TEXT,
    seat_token_id TEXT
);

CREATE INDEX support_message_ticket ON support_message(ticket_id, id);

-- 321 (FR-321-10) — `AI Agent`'s transcript, one row per request sent for a ticket. Must stay byte-for-byte in sync with
-- 80.sqm. The verdict is `SENT`, `FORWARDED: <rule>`, `FLAGGED` or `DISCARDED: <why>`; null while the batch is out.
CREATE TABLE support_ai_turn (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    ticket_id INTEGER NOT NULL,
    owner_user_id TEXT NOT NULL,
    batch_id TEXT NOT NULL,
    custom_id TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    model TEXT NOT NULL,
    sent TEXT NOT NULL,
    answer TEXT,
    verdict TEXT,
    input_tokens INTEGER NOT NULL DEFAULT 0,
    output_tokens INTEGER NOT NULL DEFAULT 0,
    cost_micro_usd INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX support_ai_turn_ticket ON support_ai_turn(ticket_id, id);

CREATE INDEX support_ai_turn_owner ON support_ai_turn(owner_user_id, created_at);

-- DEB-1508 (FR-1) — Hervør's support seat token: one live row per seat, `token_hash` the `sha256Hex` of a `jss_` bearer
-- that is shown once and never stored. Rows are never deleted: a revoked row is the audit record of a token that existed.
-- Times are epoch SECONDS. Must stay byte-for-byte in sync with 82.sqm (the SQLDelight-migration rule); `seat` is a column
-- so a later spec can add a second seat without a migration. `support_message.seat_token_id` (FR-13) is set on every line a
-- seat call writes and never leaves the server.
CREATE TABLE support_seat_token (
    id TEXT NOT NULL PRIMARY KEY,
    seat TEXT NOT NULL,
    token_hash TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    created_by TEXT NOT NULL,
    last_used_at INTEGER,
    revoked_at INTEGER,
    revoked_by TEXT
);

CREATE INDEX support_seat_token_hash ON support_seat_token(token_hash);

insertTicket:
INSERT INTO support_ticket(owner_user_id, state, holder, holder_seat, owes, owed_since, viewer_language, created_at, updated_at)
VALUES (?, ?, ?, NULL, ?, ?, ?, ?, ?);

lastInsertId:
SELECT last_insert_rowid();

insertMessage:
INSERT INTO support_message(ticket_id, kind, author, author_label, body, event, event_args, visibility, device_platform, device_id, created_at, actor, actor_label)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

ticket:
SELECT * FROM support_ticket WHERE id = :id;

ticketsOf:
SELECT * FROM support_ticket WHERE owner_user_id = :owner ORDER BY updated_at DESC, id DESC;

allTickets:
SELECT * FROM support_ticket ORDER BY updated_at DESC, id DESC;

messages:
SELECT * FROM support_message WHERE ticket_id = :ticket ORDER BY id;

lastMessageId:
SELECT COALESCE(MAX(id), 0) FROM support_message WHERE ticket_id = :ticket;

firstMessage:
SELECT body FROM support_message WHERE ticket_id = :ticket AND kind = 'MESSAGE' AND visibility = 'VIEWER' ORDER BY id LIMIT 1;

touch:
UPDATE support_ticket SET updated_at = :now WHERE id = :id;

setRouting:
UPDATE support_ticket SET state = :state, holder = :holder, holder_seat = :seat, owes = :owes, owed_since = :owed_since, updated_at = :now
WHERE id = :id;

setOwes:
UPDATE support_ticket SET owes = :owes, owed_since = :owed_since, updated_at = :now WHERE id = :id;

setClass:
UPDATE support_ticket SET class = :ticket_class, updated_at = :now WHERE id = :id;

-- Deliberately does not touch updated_at: a flagged ticket must look exactly as it did to the viewer (FR-320-12).
setFlag:
UPDATE support_ticket SET flagged = :flagged WHERE id = :id;

setEnglishSummary:
UPDATE support_ticket SET english_summary = :summary WHERE id = :id;

-- DEB-1500 (FR-13) — `AI Agent` titles the case once: each title is written only while it is still null, and neither
-- touches updated_at (the title is not a new thing the viewer is told about).
setTitles:
UPDATE support_ticket SET title = COALESCE(title, :title), english_title = COALESCE(english_title, :english_title) WHERE id = :id;

moveViewerRead:
UPDATE support_ticket SET viewer_read_message_id = :up_to WHERE id = :id AND viewer_read_message_id < :up_to;

moveAdminRead:
UPDATE support_ticket SET admin_read_message_id = :up_to WHERE id = :id AND admin_read_message_id < :up_to;

deleteMessages:
DELETE FROM support_message WHERE ticket_id = :ticket;

deleteTicket:
DELETE FROM support_ticket WHERE id = :id;

ticketsSince:
SELECT COUNT(*) FROM support_ticket WHERE owner_user_id = :owner AND created_at > :since;

oldestTicketSince:
SELECT MIN(created_at) FROM support_ticket WHERE owner_user_id = :owner AND created_at > :since;

messagesSince:
SELECT COUNT(*) FROM support_message
WHERE kind = 'MESSAGE' AND author = 'VIEWER' AND created_at > :since
  AND ticket_id IN (SELECT id FROM support_ticket WHERE owner_user_id = :owner);

oldestMessageSince:
SELECT MIN(created_at) FROM support_message
WHERE kind = 'MESSAGE' AND author = 'VIEWER' AND created_at > :since
  AND ticket_id IN (SELECT id FROM support_ticket WHERE owner_user_id = :owner);

sameHereSince:
SELECT COUNT(*) FROM support_message
WHERE ticket_id = :ticket AND kind = 'SAME_HERE' AND device_id = :device AND created_at > :since;

staleResolved:
SELECT id FROM support_ticket WHERE state = 'RESOLVED' AND updated_at < :before;

viewerUnread:
SELECT COUNT(*) FROM support_message
WHERE ticket_id = :ticket AND id > :after AND visibility = 'VIEWER'
  AND ((kind = 'MESSAGE' AND author <> 'VIEWER') OR (kind = 'SYSTEM' AND event IN ('FORWARDED', 'STATE_CHANGED')));

adminUnread:
SELECT COUNT(*) FROM support_message
WHERE ticket_id = :ticket AND id > :after
  AND ((kind = 'MESSAGE' AND author = 'VIEWER' AND visibility = 'VIEWER') OR kind = 'SAME_HERE');

-- ─── 321 — `AI Agent` ──────────────────────────────────────────────────────

ticketsHeldBy:
SELECT * FROM support_ticket WHERE holder = :holder ORDER BY id;

insertAiTurn:
INSERT INTO support_ai_turn(ticket_id, owner_user_id, batch_id, custom_id, created_at, model, sent)
VALUES (:ticket, :owner, :batch, :custom, :created_at, :model, :sent);

setAiTurnAnswer:
UPDATE support_ai_turn SET answer = :answer, verdict = :verdict, input_tokens = :input_tokens, output_tokens = :output_tokens,
    cost_micro_usd = :cost_micro_usd
WHERE batch_id = :batch AND custom_id = :custom;

aiTurnsOf:
SELECT * FROM support_ai_turn WHERE ticket_id = :ticket ORDER BY id;

-- DEB-1500 (FR-13) — a title that was dropped rides beside the verdict (`SENT | TITLE_DROPPED: …`), so SENT is a prefix.
aiTurnsSentOf:
SELECT COUNT(*) FROM support_ai_turn WHERE ticket_id = :ticket AND (verdict = 'SENT' OR verdict LIKE 'SENT |%');

aiTurnsSince:
SELECT COUNT(*) FROM support_ai_turn WHERE owner_user_id = :owner AND created_at > :since;

deleteAiTurns:
DELETE FROM support_ai_turn WHERE ticket_id = :ticket;

lastViewerMessageId:
SELECT COALESCE(MAX(id), 0) FROM support_message
WHERE ticket_id = :ticket AND visibility = 'VIEWER' AND author = 'VIEWER' AND kind IN ('MESSAGE', 'SAME_HERE');

-- ─── DEB-1500 (FR-12) — the Support log ────────────────────────────────────

-- One log entry per row of either source, newest first. An entry's id is `id * 2` for a message and `id * 2 + 1` for a
-- turn, so the two sources never collide and `before` is one number. (created_at, id) is the order; a cursor is the
-- entry's own composite id, and its time is looked up first (logMessageAt, logTurnAt).
logMessages:
SELECT m.id AS id, m.created_at AS at, m.ticket_id AS ticket, m.kind AS kind, m.author AS author, m.author_label AS author_label,
       m.event AS event, m.event_args AS event_args, m.visibility AS visibility, m.actor AS actor, m.actor_label AS actor_label
FROM support_message m
WHERE (m.kind = 'SYSTEM' OR (m.kind = 'MESSAGE' AND m.visibility = 'VIEWER' AND m.author IN ('AI_AGENT', 'HERVOR', 'ADMIN')))
  AND (m.created_at < :at OR (m.created_at = :at AND m.id * 2 < :before))
ORDER BY m.created_at DESC, m.id DESC
LIMIT :limit;

logTurns:
SELECT t.id AS id, t.created_at AS at, t.ticket_id AS ticket, t.verdict AS verdict
FROM support_ai_turn t
WHERE t.verdict IS NOT NULL
  AND (t.created_at < :at OR (t.created_at = :at AND t.id * 2 + 1 < :before))
ORDER BY t.created_at DESC, t.id DESC
LIMIT :limit;

logMessageAt:
SELECT created_at FROM support_message WHERE id = :id;

logTurnAt:
SELECT created_at FROM support_ai_turn WHERE id = :id;

-- ─── DEB-1508 — Hervør's seat token ────────────────────────────────────────

insertSeatToken:
INSERT INTO support_seat_token(id, seat, token_hash, created_at, created_by) VALUES (:id, :seat, :token_hash, :created_at, :created_by);

liveSeatToken:
SELECT * FROM support_seat_token WHERE seat = :seat AND revoked_at IS NULL LIMIT 1;

liveSeatTokenByHash:
SELECT * FROM support_seat_token WHERE token_hash = :token_hash AND revoked_at IS NULL LIMIT 1;

pastSeatTokens:
SELECT * FROM support_seat_token WHERE seat = :seat AND revoked_at IS NOT NULL ORDER BY revoked_at DESC, created_at DESC LIMIT 5;

revokeSeatToken:
UPDATE support_seat_token SET revoked_at = :revoked_at, revoked_by = :revoked_by WHERE id = :id AND revoked_at IS NULL;

-- FR-2 — written at most once a minute: the row is touched only when its last use is older than `:before`.
touchSeatToken:
UPDATE support_seat_token SET last_used_at = :now WHERE id = :id AND (last_used_at IS NULL OR last_used_at < :before);

-- FR-13 — a line a seat call writes. Every other writer leaves `seat_token_id` null (insertMessage).
insertSeatMessage:
INSERT INTO support_message(ticket_id, kind, author, author_label, body, event, event_args, visibility, created_at, actor, actor_label, seat_token_id)
VALUES (:ticket, :kind, :author, :author_label, :body, :event, :event_args, :visibility, :created_at, :actor, :actor_label, :seat_token_id);

-- FR-6 — the tickets Hervør has written in: a `MESSAGE` authored HERVOR, either visibility.
ticketsHervorWroteIn:
SELECT DISTINCT ticket_id FROM support_message WHERE kind = 'MESSAGE' AND author = 'HERVOR';

hervorWroteIn:
SELECT COUNT(*) FROM support_message WHERE ticket_id = :ticket AND kind = 'MESSAGE' AND author = 'HERVOR';

-- FR-11 rule 6 — what Hervør has said to viewers, counted from the store. The forward's note is `ADMIN_ONLY` and not counted.
hervorRepliesSince:
SELECT COUNT(*) FROM support_message WHERE kind = 'MESSAGE' AND author = 'HERVOR' AND visibility = 'VIEWER' AND created_at > :since;

oldestHervorReplySince:
SELECT MIN(created_at) FROM support_message WHERE kind = 'MESSAGE' AND author = 'HERVOR' AND visibility = 'VIEWER' AND created_at > :since;

hervorRepliesOnTicketSince:
SELECT COUNT(*) FROM support_message
WHERE ticket_id = :ticket AND kind = 'MESSAGE' AND author = 'HERVOR' AND visibility = 'VIEWER' AND created_at > :since;

oldestHervorReplyOnTicketSince:
SELECT MIN(created_at) FROM support_message
WHERE ticket_id = :ticket AND kind = 'MESSAGE' AND author = 'HERVOR' AND visibility = 'VIEWER' AND created_at > :since;
