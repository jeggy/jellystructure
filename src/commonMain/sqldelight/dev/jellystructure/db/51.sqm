ALTER TABLE playback_qoe ADD COLUMN video_output_recovery_rung INTEGER NOT NULL DEFAULT 0;
ALTER TABLE playback_qoe ADD COLUMN video_output_recovery_ms INTEGER NOT NULL DEFAULT 0;
ALTER TABLE playback_qoe ADD COLUMN background_returns INTEGER NOT NULL DEFAULT 0;
ALTER TABLE playback_qoe ADD COLUMN restored_after_recreate INTEGER NOT NULL DEFAULT 0;
