CREATE TABLE ravilo_pairing (
    pair_id TEXT NOT NULL PRIMARY KEY,
    code TEXT NOT NULL UNIQUE,
    poll_token TEXT NOT NULL UNIQUE,
    jellyfin_user_id TEXT,
    jellyfin_username TEXT,
    jellyfin_user_token TEXT,
    is_admin INTEGER NOT NULL DEFAULT 0,
    is_kids INTEGER NOT NULL DEFAULT 0,
    approved INTEGER NOT NULL DEFAULT 0,
    consumed INTEGER NOT NULL DEFAULT 0,
    expires_at INTEGER NOT NULL,
    -- Phase 110: the TV's own device name (Android model / browser label), captured at pairing-start
    -- and carried through to ravilo_device.display_name once the pairing is polled/consumed.
    device_name TEXT
);

insertPairing:
INSERT INTO ravilo_pairing(pair_id, code, poll_token, expires_at, device_name)
VALUES (:pair_id, :code, :poll_token, :expires_at, :device_name);

getByCode:
SELECT * FROM ravilo_pairing WHERE code = :code AND consumed = 0 AND expires_at > :now;

getByPollToken:
SELECT * FROM ravilo_pairing WHERE poll_token = :poll_token AND consumed = 0 AND expires_at > :now;

approve:
UPDATE ravilo_pairing
SET jellyfin_user_id = :jellyfin_user_id,
    jellyfin_username = :jellyfin_username,
    jellyfin_user_token = :jellyfin_user_token,
    is_admin = :is_admin,
    is_kids = :is_kids,
    approved = 1
WHERE code = :code AND consumed = 0 AND expires_at > :now;

consume:
UPDATE ravilo_pairing SET consumed = 1 WHERE poll_token = :poll_token;

deleteExpired:
DELETE FROM ravilo_pairing WHERE expires_at < :now;
