-- 308 (FR-308-5) — the video-variant switches and the variant a player was on. Must stay byte-for-byte in sync with
-- PlaybackQoe.sq's CREATE TABLE (the SQLDelight-migration rule).
ALTER TABLE playback_qoe ADD COLUMN variant_switches_down INTEGER NOT NULL DEFAULT 0;
ALTER TABLE playback_qoe ADD COLUMN variant_switches_up INTEGER NOT NULL DEFAULT 0;
ALTER TABLE playback_qoe ADD COLUMN variant_bandwidth_bps INTEGER;
ALTER TABLE playback_qoe ADD COLUMN variant_height INTEGER;
