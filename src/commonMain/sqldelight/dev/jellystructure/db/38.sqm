-- Phase 185 (FR-185-4) — see PlaybackStartSample.sq for the full column docs; this migration must stay
-- byte-for-byte in sync with that file's CREATE TABLE/CREATE INDEX statements (this repo's SQLDelight
-- setup applies .sqm files sequentially against an existing database — Schema.create() alone, used only
-- for a brand-new database, would otherwise be the only place this table exists).
CREATE TABLE playback_start_sample (
    id INTEGER NOT NULL PRIMARY KEY,
    device_id TEXT NOT NULL,
    item_id TEXT NOT NULL,
    file_id TEXT NOT NULL,
    seconds INTEGER NOT NULL,
    recorded_at INTEGER NOT NULL
);

CREATE INDEX playback_start_sample_device_file ON playback_start_sample(device_id, file_id);
