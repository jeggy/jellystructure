-- Phase 177 (FR-177-5) — playback quality-of-experience reports, posted by the client (R216 FR-R216-4)
-- at session end and on a long-session (10 min) interval. Each report carries the session's RUNNING
-- totals (dropped frames / rebuffer count+duration accumulate for the whole session, never reset
-- between posts — see PlayerStore.kt), so this is an UPSERT keyed by the same
-- (device_id, jellyfin_id, play_session_id) triple PlaybackTracker already uses (playSessionIdFor()) —
-- a mid-session report simply advances the same row to its latest cumulative state, rather than growing
-- one row per report. Diagnostic, not a ledger: retention-pruned (deleteOlderThan), not append-only.
CREATE TABLE playback_qoe (
    device_id TEXT NOT NULL,
    jellyfin_id TEXT NOT NULL,
    play_session_id TEXT NOT NULL,
    dropped_frames INTEGER NOT NULL DEFAULT 0,
    rebuffer_count INTEGER NOT NULL DEFAULT 0,
    rebuffer_ms INTEGER NOT NULL DEFAULT 0,
    bandwidth_estimate_bps INTEGER,
    video_decoder TEXT,
    direct_play INTEGER NOT NULL DEFAULT 0,
    link_kind TEXT NOT NULL DEFAULT 'unknown',
    link_mbps INTEGER NOT NULL DEFAULT 0,
    -- Phase 179 (FR-179-3) — count of sideloaded text-subtitle load errors this session (see
    -- specs/requirements/phase-179-subtitle-sideload-transcode-stall.md). Diagnostic only.
    subtitle_load_errors INTEGER NOT NULL DEFAULT 0,
    -- R237 (FR-R237-6) — the HTTP status that ended a start attempt, set ONLY when the session never
    -- reached Ready. NULL is the normal case: this session played. Without it a failed start leaves a
    -- row of nulls and zeroes that proves it failed and not why.
    start_failure_status INTEGER,
    -- R292 (FR-R292-11) — R220's FR-R220-6 made real: the recovery ladder's count, the rung that recovered
    -- last (0 = none) and its time to a new frame; the returns from the background (FR-R292-3 starts) and
    -- the restores after an activity recreation (FR-R292-6). 51.sqm.
    video_output_recoveries INTEGER NOT NULL DEFAULT 0,
    video_output_recovery_rung INTEGER NOT NULL DEFAULT 0,
    video_output_recovery_ms INTEGER NOT NULL DEFAULT 0,
    background_returns INTEGER NOT NULL DEFAULT 0,
    restored_after_recreate INTEGER NOT NULL DEFAULT 0,
    -- 308 (FR-308-5) — the player's switches between video variants (down / up) and the variant it was on at the
    -- report (its BANDWIDTH in bits/s and picture height; NULL on a stream with one variant). 70.sqm.
    variant_switches_down INTEGER NOT NULL DEFAULT 0,
    variant_switches_up INTEGER NOT NULL DEFAULT 0,
    variant_bandwidth_bps INTEGER,
    variant_height INTEGER,
    -- 309 (FR-309-13) — how many transfers the bandwidth estimate rests on, their bytes, and the time to the first
    -- frame where the player measures it. NULL from players that don't count (older apps). 72.sqm.
    bandwidth_samples INTEGER,
    bandwidth_bytes INTEGER,
    first_frame_ms INTEGER,
    updated_at INTEGER NOT NULL,
    -- R381 (FR-R381-1/-3/-4) — 1 when the counters above are the item's own (an app with R381); 0 = a legacy row
    -- whose rebuffer counts were session totals or a reused player's next start, never read (73.sqm). The item's
    -- counted stalls and its named non-stall waits as JSON, and the session's running totals.
    per_item INTEGER NOT NULL DEFAULT 0,
    stalls_json TEXT,
    waits_json TEXT,
    session_rebuffer_count INTEGER NOT NULL DEFAULT 0,
    session_rebuffer_ms INTEGER NOT NULL DEFAULT 0,
    -- 309 (FR-309-11) — the variant the item started on (its BANDWIDTH; NULL on one stream or an older app), and
    -- 313 (FR-313-13) which encoder served the play: `ours`, `jellyfin` or `direct` (server-resolved). 77.sqm.
    start_variant_bps INTEGER,
    encoder TEXT,
    PRIMARY KEY (device_id, jellyfin_id, play_session_id)
);
CREATE INDEX playback_qoe_device ON playback_qoe(device_id);
CREATE INDEX playback_qoe_updated ON playback_qoe(updated_at);

upsertQoe:
INSERT OR REPLACE INTO playback_qoe(device_id, jellyfin_id, play_session_id, dropped_frames, rebuffer_count, rebuffer_ms, bandwidth_estimate_bps, video_decoder, direct_play, link_kind, link_mbps, subtitle_load_errors, start_failure_status, video_output_recoveries, video_output_recovery_rung, video_output_recovery_ms, background_returns, restored_after_recreate, variant_switches_down, variant_switches_up, variant_bandwidth_bps, variant_height, bandwidth_samples, bandwidth_bytes, first_frame_ms, updated_at, per_item, stalls_json, waits_json, session_rebuffer_count, session_rebuffer_ms, start_variant_bps, encoder)
VALUES (:device_id, :jellyfin_id, :play_session_id, :dropped_frames, :rebuffer_count, :rebuffer_ms, :bandwidth_estimate_bps, :video_decoder, :direct_play, :link_kind, :link_mbps, :subtitle_load_errors, :start_failure_status, :video_output_recoveries, :video_output_recovery_rung, :video_output_recovery_ms, :background_returns, :restored_after_recreate, :variant_switches_down, :variant_switches_up, :variant_bandwidth_bps, :variant_height, :bandwidth_samples, :bandwidth_bytes, :first_frame_ms, :updated_at, :per_item, :stalls_json, :waits_json, :session_rebuffer_count, :session_rebuffer_ms, :start_variant_bps, :encoder);

recentForDevice:
SELECT * FROM playback_qoe WHERE device_id = :device_id ORDER BY updated_at DESC LIMIT :result_limit;

recent:
SELECT * FROM playback_qoe ORDER BY updated_at DESC LIMIT :result_limit;

deleteOlderThan:
DELETE FROM playback_qoe WHERE updated_at < :cutoff;
