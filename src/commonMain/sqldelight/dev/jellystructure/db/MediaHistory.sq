CREATE TABLE media_history (
    id INTEGER NOT NULL PRIMARY KEY,
    media_id TEXT NOT NULL,
    ts INTEGER NOT NULL,
    action TEXT NOT NULL,
    detail TEXT NOT NULL,
    revertable INTEGER NOT NULL DEFAULT 0,
    before_snapshot TEXT NOT NULL DEFAULT ''
);

CREATE INDEX media_history_media_id ON media_history(media_id);
CREATE INDEX media_history_ts ON media_history(ts);

insert:
INSERT INTO media_history(media_id, ts, action, detail, revertable, before_snapshot)
VALUES (:media_id, :ts, :action, :detail, :revertable, :before_snapshot);

forItem:
SELECT * FROM media_history WHERE media_id = :media_id ORDER BY ts DESC;

findById:
SELECT * FROM media_history WHERE id = :id LIMIT 1;

recent:
SELECT * FROM media_history ORDER BY ts DESC LIMIT :limit;

count:
SELECT COUNT(*) FROM media_history;

-- Phase 285 (FR-285-8) — what changed since an admin last opened the Dashboard.
since:
SELECT * FROM media_history WHERE ts > :since ORDER BY ts DESC LIMIT :limit;

-- FR-316-10 (DEB-1330) — the ring never deletes the mover's or the repair's record, however old: FR-316-7 reads
-- `moved_into_folder` lines as its only input, and those lines and `rebound_jellyfin_id` are the undo record of
-- FR-316-9 and FR-316-7. Every other action is trimmed to the newest [max_rows] as before; ties on `ts` break by id.
trimToMax:
DELETE FROM media_history
WHERE action NOT IN ('moved_into_folder', 'rebound_jellyfin_id') AND id NOT IN (
    SELECT id FROM media_history ORDER BY ts DESC, id DESC LIMIT :max_rows
);

-- FR-316-7 (DEB-1252) — every entry of one action, oldest first: the repair reads each `moved_into_folder` line.
byAction:
SELECT * FROM media_history WHERE action = :action ORDER BY ts, id;
