CREATE TABLE media_job (
    id TEXT NOT NULL PRIMARY KEY,
    type TEXT NOT NULL,               -- reorder | remove | bulk_reorder | segments_movie | segments_season | segments_episodes
    media_id TEXT NOT NULL,
    label TEXT NOT NULL,              -- display title for the Jobs page, e.g. "Some Movie (2019)"
    params TEXT NOT NULL,             -- JSON-encoded MediaJobParams (op-specific args)
    state TEXT NOT NULL,              -- queued | running | done | failed | cancelled
    enqueued_by TEXT NOT NULL DEFAULT 'admin',
    created_at INTEGER NOT NULL,
    started_at INTEGER,
    finished_at INTEGER,
    error TEXT,
    file_count INTEGER NOT NULL DEFAULT 1,
    files_done INTEGER NOT NULL DEFAULT 0,
    pct REAL NOT NULL DEFAULT 0,      -- live progress of the file currently being remuxed
    speed TEXT,                       -- ffmpeg's own "speed=" readout, e.g. "2.3x" (Phase 164: repurposed
                                       -- by the segments lane's fingerprint tier for its own live detail text)
    eta_seconds INTEGER,              -- Phase 123: estimated seconds remaining, derived from speed + duration
    -- Phase 164 added 'segments' as a second queue; Phase 213 added 'subtitles' as a third and made all
    -- three share one worker pool (behavior.job_workers) instead of sizing independently — a queue may
    -- never have more than one worker drawing from it at once, so this column is still what enforces
    -- "at most one active X at a time" per queue, same as it always has. See MediaJobQueue.kt.
    lane TEXT NOT NULL DEFAULT 'media',   -- media | segments | subtitles
    dedupe_key TEXT,                      -- segments/subtitles only: enforces "never queued/running
                                           -- twice for the same item" via the partial unique index
                                           -- below, not a check-then-insert
    -- Phase 261 (FR-261-2, dev review items 2-3) — the row's own "wait while a TV plays" flag as a column
    -- (was only inside `params`, JSON-parsed for every queued row on every claim), and its place in the
    -- lane: -1 = a file check due by cadence (yields to everything else), 0 = everything else, 1 = an
    -- operator's Check now. The claim orders priority DESC, then created_at, then rowid.
    defer_while_playing INTEGER NOT NULL DEFAULT 0,
    priority INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX media_job_state ON media_job(state);
CREATE INDEX media_job_media_id ON media_job(media_id);
CREATE INDEX media_job_lane_state ON media_job(lane, state);
CREATE UNIQUE INDEX media_job_dedupe_active
    ON media_job(dedupe_key)
    WHERE dedupe_key IS NOT NULL AND state IN ('queued', 'running');
CREATE INDEX media_job_claim ON media_job(lane, state, priority DESC, created_at);

insert:
INSERT INTO media_job(id, type, media_id, label, params, state, enqueued_by, created_at, file_count, lane, dedupe_key, defer_while_playing, priority)
VALUES (:id, :type, :media_id, :label, :params, :state, :enqueued_by, :created_at, :file_count, :lane, :dedupe_key, :defer_while_playing, :priority);

-- Phase 261 (FR-261-2) — the claim reads ONE candidate per lane, never the whole queue: the lane's next row,
-- or (while a TV plays and the household defers) its next row that does not wait for playback.
nextQueued:
SELECT * FROM media_job WHERE lane = :lane AND state = 'queued'
ORDER BY priority DESC, created_at ASC, rowid ASC LIMIT 1;

nextQueuedNotDeferred:
SELECT * FROM media_job WHERE lane = :lane AND state = 'queued' AND defer_while_playing = 0
ORDER BY priority DESC, created_at ASC, rowid ASC LIMIT 1;

-- Phase 261 (dev review item 2) — an operator's Check now that meets a waiting cadence row for the same file
-- raises that row instead of answering "already queued": otherwise the click sits deferred at the back.
promoteQueued:
UPDATE media_job SET priority = :priority, defer_while_playing = 0
WHERE dedupe_key = :dedupe_key AND state = 'queued' AND (priority < :priority OR defer_while_playing != 0);

countQueuedByLane:
SELECT COUNT(*) FROM media_job WHERE lane = :lane AND state = 'queued';

countQueuedNotDeferredByLane:
SELECT COUNT(*) FROM media_job WHERE lane = :lane AND state = 'queued' AND defer_while_playing = 0;

-- Phase 261 (dev review item 3) — replaces a scan of the last 50 finished rows, which per-file rows flood.
lastFailure:
SELECT error FROM media_job WHERE lane = :lane AND state = 'failed' ORDER BY finished_at DESC LIMIT 1;

-- Phase 261 (FR-261-2, dev review item 1) — the Jobs view lists per-file types as one group line each, so
-- GET /api/jobs never answers thousands of rows every 2 s. These two leave them out of the flat lists
-- (Recent keeps a per-file row only when it failed — a failure is an event, OQ3).
listQueuedExcept:
SELECT * FROM media_job WHERE state = 'queued' AND type NOT IN :types ORDER BY created_at ASC;

listRecentExcept:
SELECT * FROM media_job WHERE state IN ('done', 'failed', 'cancelled') AND (state != 'cancelled' OR error IS NULL OR error != 'emptied')
AND (type NOT IN :types OR state = 'failed')
ORDER BY COALESCE(finished_at, created_at) DESC LIMIT :max_rows;

groupCounts:
SELECT type, state, COUNT(*) AS n FROM media_job
WHERE type IN :types AND (state IN ('queued', 'running') OR COALESCE(finished_at, 0) >= :since)
GROUP BY type, state;

-- Phase 261 (FR-261-10) — the Checks card's "queued" per file: this title's waiting/running file checks.
activeFileChecksForItem:
SELECT dedupe_key, state FROM media_job WHERE media_id = :media_id AND type IN :types AND state IN ('queued', 'running');

-- The expanded group: its waiting rows in claim order, or its latest finished rows.
listByTypeQueued:
SELECT * FROM media_job WHERE type = :type AND state = 'queued'
ORDER BY priority DESC, created_at ASC, rowid ASC LIMIT :max_rows;

listByTypeRunning:
SELECT * FROM media_job WHERE type = :type AND state = 'running' ORDER BY started_at ASC;

listByTypeFinished:
SELECT * FROM media_job WHERE type = :type AND state IN ('done', 'failed', 'cancelled') AND (error IS NULL OR error != 'emptied')
ORDER BY COALESCE(finished_at, created_at) DESC LIMIT :max_rows;

findById:
SELECT * FROM media_job WHERE id = :id;

findByDedupeKeyActive:
SELECT * FROM media_job WHERE dedupe_key = :dedupe_key AND state IN ('queued', 'running') LIMIT 1;

-- Combined across both lanes, oldest first — the Jobs & workers queue panel renders one interleaved
-- list with a per-row lane badge rather than two separate queue views (FR-164-6).
listQueued:
SELECT * FROM media_job WHERE state = 'queued' ORDER BY created_at ASC;

listQueuedByLane:
SELECT * FROM media_job WHERE lane = :lane AND state = 'queued' ORDER BY created_at ASC;

-- No LIMIT 1 (unlike pre-164): the segments lane can have several rows running at once.
listRunning:
SELECT * FROM media_job WHERE state = 'running' ORDER BY started_at ASC;

listRunningByLane:
SELECT * FROM media_job WHERE lane = :lane AND state = 'running' ORDER BY started_at ASC;

-- Phase 260 (FR-260-6, dev review item 3) — rows an admin emptied out of a queue carry error = 'emptied'
-- and are NOT listed one by one; the one `queue_emptied` record per emptied queue is listed instead.
listRecent:
SELECT * FROM media_job WHERE state IN ('done', 'failed', 'cancelled') AND (state != 'cancelled' OR error IS NULL OR error != 'emptied')
ORDER BY COALESCE(finished_at, created_at) DESC LIMIT :max_rows;

-- Phase 260 (FR-260-2, dev review item 1) — conditional on `queued`: a row emptied between a worker's
-- read and this write must not be flipped back to running. The caller checks `changes` — 0 = lost the race.
markRunning:
UPDATE media_job SET state = 'running', started_at = :started_at WHERE id = :id AND state = 'queued';

changes:
SELECT changes();

-- Phase 260 (FR-260-2) — only what is WAITING in one queue; running rows are not read, touched or
-- signalled. One statement per selected queue inside one transaction (dev review item 5). A cancelled
-- row leaves the partial unique index, so the same work can be queued again later.
emptyLane:
UPDATE media_job SET state = 'cancelled', finished_at = :finished_at, error = 'emptied'
WHERE lane = :lane AND state = 'queued';

-- Phase 260 (FR-260-6) — the synthetic `queue_emptied` record: already finished when inserted; file_count
-- carries how many were removed, speed the "kept the running job — …" clause (164's precedent for detail text).
insertRecord:
INSERT INTO media_job(id, type, media_id, label, params, state, enqueued_by, created_at, started_at, finished_at, file_count, lane, speed)
VALUES (:id, :type, :media_id, :label, :params, 'done', :enqueued_by, :created_at, :started_at, :finished_at, :file_count, :lane, :speed);

updateProgress:
UPDATE media_job SET pct = :pct, speed = :speed, files_done = :files_done, eta_seconds = :eta_seconds WHERE id = :id;

markFinished:
UPDATE media_job SET state = :state, finished_at = :finished_at, error = :error, files_done = :files_done WHERE id = :id;

requeueRunning:
UPDATE media_job SET state = 'queued', started_at = NULL, pct = 0, speed = NULL, eta_seconds = NULL WHERE state = 'running';

-- Phase 213 — the subtitles queue's own mid-item stop-and-resume (playback started, or a timed-out
-- retry still under its cap): puts ONE row back to queued rather than finishing it and inserting a new
-- one, so its id/created_at/history stay put. `created_at` is deliberately left untouched — the row
-- keeps its place in FIFO order rather than jumping to the back on every defer.
requeueOne:
UPDATE media_job SET state = 'queued', started_at = NULL, pct = 0, speed = NULL, eta_seconds = NULL WHERE id = :id;

deleteOld:
DELETE FROM media_job WHERE state IN ('done', 'failed', 'cancelled') AND COALESCE(finished_at, created_at) < :cutoff;

countByState:
SELECT state, COUNT(*) AS n FROM media_job WHERE state IN ('queued', 'running') GROUP BY state;

-- Phase 164 — per-lane counterpart, feeds the two worker-line summary chips.
countByLaneState:
SELECT lane, state, COUNT(*) AS n FROM media_job WHERE state IN ('queued', 'running') GROUP BY lane, state;

countDoneToday:
SELECT COUNT(*) FROM media_job WHERE state IN ('done', 'failed') AND finished_at >= :since;

countDoneTodayByLane:
SELECT lane, COUNT(*) AS n FROM media_job WHERE state IN ('done', 'failed') AND finished_at >= :since GROUP BY lane;
