CREATE TABLE media_job (
    id TEXT NOT NULL PRIMARY KEY,
    type TEXT NOT NULL,               -- reorder | remove | bulk_reorder | segments_movie | segments_season | segments_episodes
    media_id TEXT NOT NULL,
    label TEXT NOT NULL,              -- display title for the Jobs page, e.g. "Some Movie (2019)"
    params TEXT NOT NULL,             -- JSON-encoded MediaJobParams (op-specific args)
    state TEXT NOT NULL,              -- queued | running | done | failed | cancelled
    enqueued_by TEXT NOT NULL DEFAULT 'admin',
    created_at INTEGER NOT NULL,
    started_at INTEGER,
    finished_at INTEGER,
    error TEXT,
    file_count INTEGER NOT NULL DEFAULT 1,
    files_done INTEGER NOT NULL DEFAULT 0,
    pct REAL NOT NULL DEFAULT 0,      -- live progress of the file currently being remuxed
    speed TEXT,                       -- ffmpeg's own "speed=" readout, e.g. "2.3x" (Phase 164: repurposed
                                       -- by the segments lane's fingerprint tier for its own live detail text)
    eta_seconds INTEGER,              -- Phase 123: estimated seconds remaining, derived from speed + duration
    -- Phase 164 — a second worker lane (concurrency > 1, unlike the media lane's FIFO-1) for
    -- detect_segments work, extracted off the pipeline's critical path. See MediaJobQueue.kt.
    lane TEXT NOT NULL DEFAULT 'media',   -- media | segments
    dedupe_key TEXT                       -- segments lane only: enforces "never queued/running twice"
                                           -- via the partial unique index below, not a check-then-insert
);

CREATE INDEX media_job_state ON media_job(state);
CREATE INDEX media_job_media_id ON media_job(media_id);
CREATE INDEX media_job_lane_state ON media_job(lane, state);
CREATE UNIQUE INDEX media_job_dedupe_active
    ON media_job(dedupe_key)
    WHERE dedupe_key IS NOT NULL AND state IN ('queued', 'running');

insert:
INSERT INTO media_job(id, type, media_id, label, params, state, enqueued_by, created_at, file_count, lane, dedupe_key)
VALUES (:id, :type, :media_id, :label, :params, :state, :enqueued_by, :created_at, :file_count, :lane, :dedupe_key);

findById:
SELECT * FROM media_job WHERE id = :id;

findByDedupeKeyActive:
SELECT * FROM media_job WHERE dedupe_key = :dedupe_key AND state IN ('queued', 'running') LIMIT 1;

-- Combined across both lanes, oldest first — the Jobs & workers queue panel renders one interleaved
-- list with a per-row lane badge rather than two separate queue views (FR-164-6).
listQueued:
SELECT * FROM media_job WHERE state = 'queued' ORDER BY created_at ASC;

listQueuedByLane:
SELECT * FROM media_job WHERE lane = :lane AND state = 'queued' ORDER BY created_at ASC;

-- No LIMIT 1 (unlike pre-164): the segments lane can have several rows running at once.
listRunning:
SELECT * FROM media_job WHERE state = 'running' ORDER BY started_at ASC;

listRunningByLane:
SELECT * FROM media_job WHERE lane = :lane AND state = 'running' ORDER BY started_at ASC;

listRecent:
SELECT * FROM media_job WHERE state IN ('done', 'failed', 'cancelled') ORDER BY COALESCE(finished_at, created_at) DESC LIMIT :max_rows;

markRunning:
UPDATE media_job SET state = 'running', started_at = :started_at WHERE id = :id;

updateProgress:
UPDATE media_job SET pct = :pct, speed = :speed, files_done = :files_done, eta_seconds = :eta_seconds WHERE id = :id;

markFinished:
UPDATE media_job SET state = :state, finished_at = :finished_at, error = :error, files_done = :files_done WHERE id = :id;

requeueRunning:
UPDATE media_job SET state = 'queued', started_at = NULL, pct = 0, speed = NULL, eta_seconds = NULL WHERE state = 'running';

deleteOld:
DELETE FROM media_job WHERE state IN ('done', 'failed', 'cancelled') AND COALESCE(finished_at, created_at) < :cutoff;

countByState:
SELECT state, COUNT(*) AS n FROM media_job WHERE state IN ('queued', 'running') GROUP BY state;

-- Phase 164 — per-lane counterpart, feeds the two worker-line summary chips.
countByLaneState:
SELECT lane, state, COUNT(*) AS n FROM media_job WHERE state IN ('queued', 'running') GROUP BY lane, state;

countDoneToday:
SELECT COUNT(*) FROM media_job WHERE state IN ('done', 'failed') AND finished_at >= :since;

countDoneTodayByLane:
SELECT lane, COUNT(*) AS n FROM media_job WHERE state IN ('done', 'failed') AND finished_at >= :since GROUP BY lane;
