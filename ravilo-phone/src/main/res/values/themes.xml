<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme: platform no-action-bar (ComponentActivity needs no AppCompat). -->
    <style name="Theme.Ravilo" parent="@android:style/Theme.Material.NoActionBar" />

    <!-- Android 12+ splash screen; hands off to Theme.Ravilo on entry -->
    <style name="Theme.Ravilo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A0C13</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Ravilo</item>
    </style>
</resources>
